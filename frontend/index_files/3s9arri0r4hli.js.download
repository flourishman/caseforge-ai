html, body { background: #525659; }
`,m=`
html, body { background: #fff; scrollbar-width: none; }
html::-webkit-scrollbar, body::-webkit-scrollbar { width: 0; height: 0; display: none; }
.docx-viewer__pages { padding: 0; }
.docx-viewer__page { box-shadow: none; max-width: none; }
`,h=`
.docx-viewer__pages { padding: 16px 0; }
.docx-viewer[data-editing] { padding-bottom: var(--artifact-editor-bottom-clearance); }
.docx-viewer__page {
  display: block;
  margin: 0 auto;
  background: #fff;
  color: #111;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  width: 900px;
  padding: 32px 24px;
  box-sizing: border-box;
}
.docx-viewer__page[contenteditable="true"] {
  caret-color: #0866ff;
  outline: 2px solid transparent;
}
.docx-viewer__page[contenteditable="true"]:focus-visible {
  outline-color: rgba(8, 102, 255, 0.28);
}
.docx-viewer__page p[${d}="Normal"],
.docx-viewer__page p[${d}="Normal"] * {
  font-size: 11pt !important;
  line-height: 1.15 !important;
}
.docx-viewer__page p[${d}="Title"],
.docx-viewer__page p[${d}="Title"] * {
  font-size: 28pt !important;
  line-height: 1.15 !important;
}
.docx-viewer__page p[${d}="Subtitle"],
.docx-viewer__page p[${d}="Subtitle"] * {
  color: #595959 !important;
  font-size: 15pt !important;
  line-height: 1.2 !important;
}
.docx-viewer__page p[${d}="Heading1"],
.docx-viewer__page p[${d}="Heading1"] * {
  font-size: 20pt !important;
  line-height: 1.2 !important;
}
.docx-viewer__page p[${d}="Heading2"],
.docx-viewer__page p[${d}="Heading2"] * {
  font-size: 16pt !important;
  line-height: 1.2 !important;
}
.docx-viewer__page p[${d}="Heading3"],
.docx-viewer__page p[${d}="Heading3"] * {
  font-size: 13pt !important;
  line-height: 1.2 !important;
}
.docx-viewer__page p[${f}="left"] {
  text-align: left !important;
}
.docx-viewer__page p[${f}="center"] {
  text-align: center !important;
}
.docx-viewer__page p[${f}="right"] {
  text-align: right !important;
}
