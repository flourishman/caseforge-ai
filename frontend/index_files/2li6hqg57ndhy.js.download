  @keyframes ecto-dropzone-ants { to { stroke-dashoffset: -10px; } }
  @keyframes ecto-dropzone-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }
  @keyframes ecto-dropzone-hop {
    0% { transform: translateY(0); animation-timing-function: ease-out; }
    45% { transform: translateY(-6px); animation-timing-function: ease-in; }
    100% { transform: translateY(0); }
  }
  .ecto-dropzone-ants-rect {
    x: 0.75px;
    y: 0.75px;
    width: calc(100% - 1.5px);
    height: calc(100% - 1.5px);
    rx: 23.25px;
    ry: 23.25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5px;
    stroke-dasharray: 6 4;
    opacity: 0.7;
    animation: ecto-dropzone-ants 1.8s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) { .ecto-dropzone-ants-rect { animation: none; } }
